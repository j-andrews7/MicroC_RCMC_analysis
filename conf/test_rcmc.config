/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal RCMC tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same as the `test` profile, but in RCMC mode using the demo capture regions on chr16.

    Use as follows:
        nextflow run j-andrews7/MicroC_RCMC_analysis -profile test_rcmc,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'RCMC test profile'
    config_profile_description = 'Minimal RCMC test (demo hg19 chr16 reads + demo capture regions)'

    regions              = "${projectDir}/demo/capture_locus.bed"
    mustache_chromosomes = null
}
