/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal differential loop tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same as the `test` profile, but with two conditions (WT: 1 replicate x 2 lanes,
    KO: 2 replicates) built from the demo reads, and diff_mustache enabled via --contrasts.
    The conditions contain identical reads, so no differential loops are expected.

    Use as follows:
        nextflow run j-andrews7/MicroC_RCMC_analysis -profile test_diff,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

includeConfig 'test.config'

params {
    config_profile_name        = 'Differential loops test profile'
    config_profile_description = 'Minimal multi-condition/replicate/lane test with diff_mustache'

    input                = "${projectDir}/assets/samplesheet_demo_diff.csv"
    contrasts            = "${projectDir}/assets/contrasts_demo.csv"
    diff_loops           = true
    mustache_resolutions = '10000'
}
