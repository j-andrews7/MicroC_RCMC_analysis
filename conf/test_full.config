/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the full demo
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Reproduces the demo of the original Snakemake pipeline (legacy/snakemake): demo reads
    aligned to the full hg19 genome with the original default parameters. Use this to compare
    against a legacy Snakemake run with `bin/compare_outputs.py` (see docs/usage.md).
    Building the full hg19 bwa-mem2 index needs ~90 GB of memory; pass `--bwamem2_index` or
    `--fasta` pointing to a FASTA with an existing index next to it to skip indexing.

    Use as follows:
        nextflow run j-andrews7/MicroC_RCMC_analysis -profile test_full,<docker/singularity/institute> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full demo profile'
    config_profile_description = 'Original Snakemake demo (demo reads, full hg19 reference)'

    input      = "${projectDir}/assets/samplesheet_demo.csv"
    fasta      = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.fa.gz'
    chromsizes = "${projectDir}/demo/hg19.sorted.chrom.sizes"
    assembly   = 'hg19'
}
