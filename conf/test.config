/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Micro-C demo data shipped with the repository (3M reads mapping to hg19 chr16), aligned
    to hg19 chr16 only so the bwa-mem2 index can be built quickly on a laptop/CI runner.
    Alignment is split into chunks of 500,000 read pairs to exercise the chunking logic.

    Use as follows:
        nextflow run j-andrews7/MicroC_RCMC_analysis -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '6.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset (demo hg19 chr16 Micro-C reads) to check pipeline function'

    input                = "${projectDir}/assets/samplesheet_demo.csv"
    fasta                = 'https://hgdownload.soe.ucsc.edu/goldenPath/hg19/chromosomes/chr16.fa.gz'
    chromsizes           = "${projectDir}/demo/hg19.sorted.chrom.sizes"
    assembly             = 'hg19'

    split_fastq          = 500000
    mustache_resolutions = '5000,10000'
    mustache_chromosomes = 'chr16'
}
