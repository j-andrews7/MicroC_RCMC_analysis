/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.

    Published output layout matches the original Snakemake pipeline:
        dedup/, repmerge/, repcools/, conditioncools/, beds/ (RCMC only)
    plus additional outputs: logs/, loops/, diffloops/, fastqc/, multiqc/, genome/, pipeline_info/
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    //
    // QC
    //
    withName: 'FASTQC' {
        ext.args   = '--quiet'
        publishDir = [
            path: { "${params.outdir}/fastqc" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,zip}'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    //
    // Reference
    //
    withName: 'BWAMEM2_INDEX' {
        publishDir = [
            path: { "${params.outdir}/genome" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'MAKE_BLACKLIST' {
        publishDir = [
            path: { "${params.outdir}/beds" },
            mode: params.publish_dir_mode,
            pattern: '*.bed'
        ]
    }

    //
    // FASTQ -> pairs
    //
    withName: 'SEQKIT_SPLIT2' {
        ext.args   = { "--by-size ${params.split_fastq} --compress-level 1" }
        publishDir = [ enabled: false ]
    }

    withName: 'BWAMEM2_PARSE2' {
        ext.prefix = { meta.n_chunks > 1 ? "${meta.id}.part_${String.format('%03d', meta.chunk)}" : "${meta.id}" }
        publishDir = [
            path: { "${params.outdir}/logs/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'PAIRTOOLS_SORT_LANE' {
        publishDir = [
            path: { "${params.outdir}/logs/alignment" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'PAIRTOOLS_MERGE_DEDUP' {
        publishDir = [
            [
                path: { "${params.outdir}/dedup" },
                mode: params.publish_dir_mode,
                pattern: '*.{pairs.gz,stats}'
            ],
            [
                path: { "${params.outdir}/logs/dedup" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: 'PAIRTOOLS_MERGE_REPS' {
        publishDir = [
            [
                path: { "${params.outdir}/repmerge" },
                mode: params.publish_dir_mode,
                pattern: '*.pairs.gz'
            ],
            [
                path: { "${params.outdir}/logs/merge" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    //
    // Pairs -> contact maps
    //
    withName: 'PAIRIX_REPS' {
        publishDir = [
            path: { "${params.outdir}/dedup" },
            mode: params.publish_dir_mode,
            pattern: '*.px2'
        ]
    }

    withName: 'PAIRIX_CONDITIONS' {
        publishDir = [
            path: { "${params.outdir}/repmerge" },
            mode: params.publish_dir_mode,
            pattern: '*.px2'
        ]
    }

    withName: 'COOLER_CLOAD_REPS' {
        publishDir = [
            [
                path: { "${params.outdir}/repcools" },
                mode: params.publish_dir_mode,
                pattern: '*.cool'
            ],
            [
                path: { "${params.outdir}/logs/repcools" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: 'COOLER_CLOAD_CONDITIONS' {
        publishDir = [
            [
                path: { "${params.outdir}/conditioncools" },
                mode: params.publish_dir_mode,
                pattern: '*.cool'
            ],
            [
                path: { "${params.outdir}/logs/conditioncools" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: 'COOLER_ZOOMIFY_REPS' {
        publishDir = [
            [
                path: { "${params.outdir}/repcools" },
                mode: params.publish_dir_mode,
                pattern: '*.mcool'
            ],
            [
                path: { "${params.outdir}/logs/repmcools" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: 'COOLER_ZOOMIFY_CONDITIONS' {
        publishDir = [
            [
                path: { "${params.outdir}/conditioncools" },
                mode: params.publish_dir_mode,
                pattern: '*.mcool'
            ],
            [
                path: { "${params.outdir}/logs/conditionmcools" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    //
    // Loop calling
    //
    withName: 'MUSTACHE' {
        ext.args = {
            [
                "-pt ${params.mustache_pt}",
                "-st ${params.mustache_st}",
                params.mustache_sz         != null ? "-sz ${params.mustache_sz}"         : '',
                params.mustache_octaves    != null ? "-oc ${params.mustache_octaves}"    : '',
                params.mustache_iterations != null ? "-i ${params.mustache_iterations}"  : '',
                params.mustache_distance   != null ? "-d ${params.mustache_distance}"    : '',
                params.mustache_norm               ? "-norm ${params.mustache_norm}"     : '',
            ].findAll { arg -> arg }.join(' ')
        }
        ext.allow_failure = { params.mustache_allow_failure }
        publishDir = [
            path: { "${params.outdir}/logs/mustache" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'DIFF_MUSTACHE' {
        ext.args = {
            [
                "-pt ${params.mustache_pt}",
                "-pt2 ${params.diff_mustache_pt2}",
                "-st ${params.mustache_st}",
                params.mustache_sz         != null ? "-sz ${params.mustache_sz}"         : '',
                params.mustache_octaves    != null ? "-oc ${params.mustache_octaves}"    : '',
                params.mustache_iterations != null ? "-i ${params.mustache_iterations}"  : '',
                params.mustache_distance   != null ? "-d ${params.mustache_distance}"    : '',
                params.mustache_norm               ? "-norm ${params.mustache_norm}"     : '',
            ].findAll { arg -> arg }.join(' ')
        }
        ext.allow_failure = { params.mustache_allow_failure }
        publishDir = [
            path: { "${params.outdir}/logs/diff_mustache" },
            mode: params.publish_dir_mode,
            pattern: '*.log'
        ]
    }

    withName: 'CAT_MUSTACHE' {
        publishDir = [
            path: { "${params.outdir}/loops" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CAT_DIFF_MUSTACHE' {
        publishDir = [
            path: { "${params.outdir}/diffloops" },
            mode: params.publish_dir_mode
        ]
    }

}
